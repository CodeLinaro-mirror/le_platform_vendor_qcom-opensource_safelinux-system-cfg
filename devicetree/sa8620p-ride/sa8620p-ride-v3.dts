#include "sa8620p_common.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. SA8620P Ride V3";
	qcom,board-id = <0x01020025 0>;
};

&ethernet0 {
	phy-mode = "2500base-x";
};

&sgmii_phy0 {
	compatible = "ethernet-phy-id31c3.1c33";
};

