	cci0_sda_default: cci0_sda_default {
		mux {
			/* CLK, DATA */
			pins = "gpio57";
			function = "cci_i2c_sda";
		};

		config {
			pins = "gpio57";
			bias-pull-up; /* PULL UP*/
			drive-strength = <2>; /* 2 MA */
		};
	};

	cci0_scl_default: cci0_scl_default {
		mux {
			/* CLK, DATA */
			pins = "gpio58";
			function = "cci_i2c_scl";
		};

		config {
			pins = "gpio58";
			bias-pull-up; /* PULL UP*/
			drive-strength = <2>; /* 2 MA */
