			};

			config {
				pins = "gpio104";
				drive-strength = <8>;   /* 8 mA */
				bias-disable;           /* NO PULL */
			};
		};
	};

	edp0_hpd_ctrl: hpd_ctrl@94 {
		mux {
			pins = "gpio94";
			function = "edp0_hot";
		};

		config {
			pins = "gpio94";
			bias-disable;
			input-enable;
			drive-strength = <2>;
		};
	};

	tert_tdm_dout {
		tert_tdm_dout_sleep: tert_tdm_dout_sleep {
			mux {
				pins = "gpio105";
