&{/reserved-memory} {
	#address-cells = <2>;
	#size-cells = <2>;
	ranges;

	auto_vm1_vblk0_ring: auto_vm1_vblk0_ring@e80000000 {
		no-map;
		reg = <0xe 0x80000000 0x0 0x4000>;
		gunyah-label = <0x100>;
	};

	auto_vm1_vblk1_ring: auto_vm1_vblk1_ring@e80004000 {
		no-map;
		reg = <0xe 0x80004000 0x0 0x4000>;
