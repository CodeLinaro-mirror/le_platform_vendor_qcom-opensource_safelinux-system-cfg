				&auto_vm1_be30
				&auto_vm1_be31
				&auto_vm1_be32
				&auto_vm1_be33
				&auto_vm1_be34>;
	};
};

&{/reserved-memory} {
	#address-cells = <2>;
	#size-cells = <2>;
	ranges;

	auto_vm1_vblk0_ring: auto_vm1_vblk0_ring@f00000000 {
		no-map;
		reg = <0xf 0x00000000 0x0 0x4000>;
		gunyah-label = <0x100>;
	};

	auto_vm1_vblk1_ring: auto_vm1_vblk1_ring@f00004000 {
		no-map;
		reg = <0xf 0x00004000 0x0 0x4000>;
		gunyah-label = <0x101>;
