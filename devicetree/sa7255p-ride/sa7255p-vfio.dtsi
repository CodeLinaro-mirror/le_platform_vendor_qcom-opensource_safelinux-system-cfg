&soc {
	umd_pil@408000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x00408000 0x0 0x1000>,
			<0x0 0x90900000 0x0 0x200000>,
			<0x0 0x00780000 0x0 0x10000>,
			<0x0 0x146d8000 0x0 0x1000>,
			<0x0 0xe640b000 0x0 0x1400000>,
			<0x0 0x95c00000 0x0 0x1e00000>,
			<0x0 0x9b800000 0x0 0x1e00000>,
			<0x0 0x9be82000 0x0 0x700000>,
			<0x0 0x9d700000 0x0 0x1e00000>,
			<0x0 0x97b00000 0x0 0x1e00000>,
			<0x0 0x99900000 0x0 0x1e00000>,
			<0x0 0x9B780000 0x0 0x2000>;
		interrupts-extended = <&ipcc IPCC_CLIENT_LPASS IPCC_MPROC_SIGNAL_SMP2P IRQ_TYPE_EDGE_RISING>,
					<&ipcc IPCC_CLIENT_CDSP  IPCC_MPROC_SIGNAL_SMP2P IRQ_TYPE_EDGE_RISING>,
					<&ipcc IPCC_CLIENT_SLPI  IPCC_MPROC_SIGNAL_SMP2P IRQ_TYPE_EDGE_RISING>,
					<&ipcc IPCC_CLIENT_GPDSP0  IPCC_MPROC_SIGNAL_SMP2P IRQ_TYPE_EDGE_RISING>,
					<&intc GIC_SPI 486 IRQ_TYPE_LEVEL_HIGH>,
					<&intc GIC_SPI 578 IRQ_TYPE_LEVEL_HIGH>,
					<&intc GIC_SPI 887 IRQ_TYPE_LEVEL_HIGH>,
					<&intc GIC_SPI 768 IRQ_TYPE_LEVEL_HIGH>,
					<&intc GIC_SPI 624 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&apps_smmu 0x0 0x0>;
		dma-coherent;
	};

	cdsp0_cb@1 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x1 0x0 0x0>;
		iommus = <&apps_smmu 0x21C1 0>,
			<&apps_smmu 0x25C1 0>,
			<&apps_smmu 0x2161 0>,
			<&apps_smmu 0x2561 0>,
			<&apps_smmu 0x2141 0>,
			<&apps_smmu 0x2541 0>,
			<&apps_smmu 0x21E1 0>,
			<&apps_smmu 0x25E1 0>,
			<&apps_smmu 0x2181 0>,
			<&apps_smmu 0x2581 0>;
		dma-coherent;
	};

	cdsp0_cb@2 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x2 0x0 0x0>;
		iommus = <&apps_smmu 0x21C2 0>,
			<&apps_smmu 0x25C2 0>,
			<&apps_smmu 0x2162 0>,
			<&apps_smmu 0x2562 0>,
			<&apps_smmu 0x2142 0>,
			<&apps_smmu 0x2542 0>,
			<&apps_smmu 0x21E2 0>,
			<&apps_smmu 0x25E2 0>,
			<&apps_smmu 0x2182 0>,
			<&apps_smmu 0x2582 0>;
		dma-coherent;
	};

	cdsp0_cb@3 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x3 0x0 0x0>;
		iommus = <&apps_smmu 0x21C3 0>,
			<&apps_smmu 0x25C3 0>,
			<&apps_smmu 0x2163 0>,
			<&apps_smmu 0x2563 0>,
			<&apps_smmu 0x2143 0>,
			<&apps_smmu 0x2543 0>,
			<&apps_smmu 0x21E3 0>,
			<&apps_smmu 0x25E3 0>,
			<&apps_smmu 0x2183 0>,
			<&apps_smmu 0x2583 0>;
		dma-coherent;
	};

	cdsp0_cb@4 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x4 0x0 0x0>;
		iommus = <&apps_smmu 0x21C4 0>,
			<&apps_smmu 0x25C4 0>,
			<&apps_smmu 0x2164 0>,
			<&apps_smmu 0x2564 0>,
			<&apps_smmu 0x2144 0>,
			<&apps_smmu 0x2544 0>,
			<&apps_smmu 0x21E4 0>,
			<&apps_smmu 0x25E4 0>,
			<&apps_smmu 0x2184 0>,
			<&apps_smmu 0x2584 0>;
		dma-coherent;
	};

	cdsp1_cb@1 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x1 0x0 0x0>;
		iommus = <&apps_smmu 0x2961 0>,
			<&apps_smmu 0x2D61 0>,
			<&apps_smmu 0x29C1 0>,
			<&apps_smmu 0x2DC1 0>,
			<&apps_smmu 0x2941 0>,
			<&apps_smmu 0x2D41 0>,
			<&apps_smmu 0x2981 0>,
			<&apps_smmu 0x2D81 0>,
			<&apps_smmu 0x29E1 0>,
			<&apps_smmu 0x2DE1 0>;
		dma-coherent;
	};

	cdsp1_cb@2 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x2 0x0 0x0>;
		iommus = <&apps_smmu 0x2962 0>,
			<&apps_smmu 0x2D62 0>,
			<&apps_smmu 0x29C2 0>,
			<&apps_smmu 0x2DC2 0>,
			<&apps_smmu 0x2942 0>,
			<&apps_smmu 0x2D42 0>,
			<&apps_smmu 0x29E2 0>,
			<&apps_smmu 0x2DE2 0>,
			<&apps_smmu 0x2982 0>,
			<&apps_smmu 0x2D82 0>;
		dma-coherent;
	};

	cdsp1_cb@3 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x3 0x0 0x0>;
		iommus = <&apps_smmu 0x2963 0>,
			<&apps_smmu 0x2D63 0>,
			<&apps_smmu 0x29C3 0>,
			<&apps_smmu 0x2DC3 0>,
			<&apps_smmu 0x2943 0>,
			<&apps_smmu 0x2D43 0>,
			<&apps_smmu 0x29E3 0>,
			<&apps_smmu 0x2DE3 0>,
			<&apps_smmu 0x2983 0>,
			<&apps_smmu 0x2D83 0>;
		dma-coherent;
	};

	cdsp1_cb@4 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x4 0x0 0x0>;
		iommus = <&apps_smmu 0x2964 0>,
			<&apps_smmu 0x2D64 0>,
			<&apps_smmu 0x29C4 0>,
			<&apps_smmu 0x2DC4 0>,
			<&apps_smmu 0x2944 0>,
			<&apps_smmu 0x2D44 0>,
			<&apps_smmu 0x29E4 0>,
			<&apps_smmu 0x2DE4 0>,
			<&apps_smmu 0x2984 0>,
			<&apps_smmu 0x2D84 0>;
		dma-coherent;
	};

	adsp_cb@2 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x2 0x0 0x0>;
		iommus = <&apps_smmu 0x3003 0x0>;
		dma-coherent;
	};

	adsp_cb@3 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x3 0x0 0x0>;
		iommus = <&apps_smmu 0x3004 0x0>;
		dma-coherent;
	};

	adsp_cb@4 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x4 0x0 0x0>;
		iommus = <&apps_smmu 0x3005 0x0>;
		dma-coherent;
	};

	gpdsp0_cb@1 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x1 0x0 0x0>;
		iommus = <&apps_smmu 0x38A1 0>;
		dma-coherent;
	};

	gpdsp0_cb@3 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x3 0x0 0x0>;
		iommus = <&apps_smmu 0x38A3 0>;
		dma-coherent;
	};

	gpdsp1_cb@1 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x1 0x0 0x0>;
		iommus = <&apps_smmu 0x38C1 0>;
		dma-coherent;
	};

	gpdsp1_cb@3 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x3 0x0 0x0>;
		iommus = <&apps_smmu 0x38C3 0>;
		dma-coherent;
	};

	tcsr_mutex_block: syscon@1f40000 {
		compatible = "syscon";
		reg = <0x1f40000 0x20000>;
	};

	smem: qcom,smem {
		compatible = "qcom,smem";
		memory-region = <&smem_mem>;
		hwlocks = <&tcsr_mutex 3>;
	};

	scm_user_intf_device {
		compatible = "qcom,scm-user-intf";
		scm_dev = "scm";
		status = "ok";
	};

	vfio_timer@17c23000 {
		compatible = "qcom,vfio-platform";
		interrupts = <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>;
		reg = <0x0 0x17c23000 0x0 0x1000>;
		iommus = <&adreno_smmu 0x7 0x0>;
		dma-coherent;
		qcom,iommu-dma-addr-pool = <0x0 0x60002000 0x0 0x1FFFE000>;
	};

	kiumd {
		compatible = "qcom,kiumd";
		qcom,dev-name = "kiumd";
		status = "ok";
	};

        vfio_dpu_00@ae00000 {
                compatible = "qcom,vfio-platform";
                interrupts = <0 92 IRQ_TYPE_LEVEL_HIGH>;
                reg = <0x0 0xae00000 0x0 0x200000>;
                iommus = <&apps_smmu 0x1000 0x402>;
                qcom,iommu-dma-addr-pool = <0x0 0x0 0x0 0xffffffff>;
                dma-coherent;
        };

	vfio_kgsl@3d00000 {
		name = "vfio_kgsl";
		compatible = "qcom,kiumd-platform";

		reg = <0x0 0x03d00000 0x0 0x6a000>,
			<0x0 0x03d6a000 0x0 0x96000>,
			<0x0 0x0b210000 0x0 0x400000>,
			<0x0 0x00780000 0x0 0x7000>,
			<0x0 0x01fc8000 0x0 0x1000>,
			<0x0 0x01fc0000 0x0 0x30000>;
		reg-names = "gpu_reg", "gmu_reg",
			"rpmh_pdc", "security_control_core",
			"tcsr_hwver_reg", "tcsr_tcsr_reg";

		interrupts = <0 300 IRQ_TYPE_LEVEL_HIGH>,
			<0 304 IRQ_TYPE_LEVEL_HIGH>,
			<0 305 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "kgsl_3d0_irq", "kgsl_hfi_irq",
				"kgsl_gmu_irq";

		iommus = <&adreno_smmu 0x0 0xc00>;
		qcom,iommu-dma = "disabled";
		dma-coherent;
	};

	vfio_gmu {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x01fc0000 0x0 0x38000>;
		reg-names = "tcsr_tcsr_reg";
		iommus = <&adreno_smmu 0x5 0xc00>;
		qcom,iommu-dma = "disabled";
		dma-coherent;
	};

	vfio_gmu_db {
		compatible = "qcom,vfio-platform";
		iommus = <&adreno_smmu 0x4 0xc00>;
		qcom,iommu-dma = "disabled";
		dma-coherent;
	};

	vfio_kgsl_secure {
		compatible = "qcom,vfio-platform";
		// switch to secure CB once ready
		iommus = <&adreno_smmu 0x7 0xc00>;
		qcom,iommu-dma-addr-pool = <0x0 0x7FFF0000>;
		qcom,iommu-dma = "disabled";
		dma-coherent;
	};

	vfio_kgsl_lpac {
		compatible = "qcom,kiumd-platform";
		iommus = <&adreno_smmu 0x1 0xc00>;
		qcom,iommu-dma = "disabled";
		dma-coherent;
	};
};
