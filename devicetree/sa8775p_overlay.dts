	};

	mini_dump_mode {
		compatible = "qcom,minidump";
		status = "ok";
	};

	qcom-smem {
		compatible = "qcom,smem";
		memory-region = <&smem_mem>;
		hwlocks = <&tcsr_mutex 3>;
		status = "okay";
	};

	scm_user_intf_device {
		compatible = "qcom,scm-user-intf";
		scm_dev = "scm";
		status = "ok";
	};

	kiumd {
		compatible = "qcom,kiumd";
		qcom,dev-name = "kiumd";
		status = "ok";
	};

	kryo_erp: erp {
	compatible = "arm,arm64-kryo-cpu-erp";
	interrupts = <GIC_PPI 0 IRQ_TYPE_LEVEL_LOW>,
			<GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "l1-l2-faultirq",
				"l3-c0-scu-faultirq",
				"l3-c1-scu-faultirq";
	};
};

&{/firmware} {
	scm {
		qcom,dload-mode = <&tcsr 0x13000>;
	};
};

&{/reserved-memory} {
	#address-cells = <2>;
	#size-cells = <2>;
	ranges;

	dump_mem: mem_dump_region {
		alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
		compatible = "shared-dma-pool";
		reusable;
		size = <0 0x3000000>;
	};

	sail_mailbox_mem: sail_mailbox_region@90d80000 {
		no-map;
		reg = <0x0 0x90d80000 0x0 0x80000>;
	};

	sail_ota_mem: sail_ota_region@0x90e00000 {
		no-map;
		reg = <0x0 0x90e00000 0x0 0x300000>;
	};

	audio_mdf_mem: audio_mdf_region@ae000000 {
		no-map;
		reg = <0x0 0xae000000 0x0 0x1000000>;
	};

        /* global autoconfigured region for contiguous allocations */
        cma: linux,cma {
                compatible = "shared-dma-pool";
                alloc-ranges = <0x0 0x00000000 0x0 0xdfffffff>;
                reusable;
                alignment = <0x0 0x400000>;
                size = <0x0 0x2000000>;
                linux,cma-default;
        };

	tz-start-count {
		reg = <0x0 0x146d87f8 0x0 0x8>;
		no-map;
	};

	tz-end-count {
		reg = <0x0 0x146d87dc 0x0 0x8>;
		no-map;
	};

	mproc_umdpil_mem: mproc_umdpil_region@adc00000 {
		no-map;
		reg = <0x0 0xadc00000 0x0 0x300000>;
        };
};
