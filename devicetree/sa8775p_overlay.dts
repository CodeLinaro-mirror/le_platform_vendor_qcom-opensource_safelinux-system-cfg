/dts-v1/;
/plugin/;

#include <dt-bindings/clock/qcom,rpmh.h>
#include <dt-bindings/clock/qcom,sa8775p-gcc.h>
#include <dt-bindings/interconnect/qcom,sa8775p-rpmh.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/power/qcom-rpmpd.h>
#include <oot-dt-bindings/qcom-ipcc.h>
#include "sa8775p-pinctrl.dtsi"
#include "sa8775p-vfio.dtsi"
#include "sa8775p-vms.dtsi"
#include "sa8775p-scmi.dtsi"

/ {
	model = "Qualcomm SA8775P Ride";
	compatible = "qcom,sa8775p-ride", "qcom,sa8775p";
};


&{/} {
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		serial1 = "/soc@0/geniqup@9c0000/serial@990000";
	};

	kaslr_store {
		compatible = "qcom,kaslr-off-store";
		reg = <0x0 0x146d86d0 0x0 0xc>;
	};

	tcsr: syscon@1fc0000 {
		compatible = "syscon";
		reg = <0x0 0x1fc0000 0x0 0x30000>;
	};

	qcom_tzlog: tz-log@146d8720 {
		compatible = "qcom,tz-log";
		reg = <0 0x146d8720 0 0x3000>;
		qcom,hyplog-enabled;
		hyplog-address-offset = <0x410>;
		hyplog-size-offset = <0x414>;
	};

	qtee_shmbridge {
		compatible = "qcom,tee-shared-memory-bridge";
		qcom,support-hypervisor;
		memory-region = <&cma>;
	};

	qcom_smcinvoke {
		compatible = "qcom,smcinvoke";
	};
};

&soc {
	qupv3_id_0: geniqup@9c0000 {
		status = "okay";
		uart4: serial@990000 {
			compatible = "qcom,geni-uart";
			reg = <0x0 0x990000 0x0 0x4000>;
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <GIC_SPI 531 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&gcc GCC_QUPV3_WRAP0_S4_CLK>;
			clock-names = "se";
			interconnects = <&clk_virt MASTER_QUP_CORE_0 0
					 &clk_virt SLAVE_QUP_CORE_0 0>,
					<&gem_noc MASTER_APPSS_PROC 0
					 &config_noc SLAVE_QUP_0 0>,
					<&aggre2_noc MASTER_QUP_0 0
					 &mc_virt SLAVE_EBI1 0>;
			interconnect-names = "qup-core", "qup-config", "qup-memory";
			power-domains = <&rpmhpd SA8775P_CX>;
			pinctrl-0 = <&qupv3_se4_2uart_active>;
			pinctrl-1 = <&qupv3_se4_2uart_sleep>;
			pinctrl-names = "default", "sleep";
			status = "okay";
		};
	};

	camcc: clock-controller@ade0000 {
		compatible = "qcom,sa8775p-camcc";
		reg = <0x0 0xade0000 0x0 0x20000>;
		clocks = <&gcc GCC_CAMERA_AHB_CLK>,
				<&rpmhcc RPMH_CXO_CLK>,
				<&rpmhcc RPMH_CXO_CLK_A>,
				<&sleep_clk>;
		power-domains = <&rpmhpd SA8775P_MMCX>;
		required-opps = <&rpmhpd_opp_nom>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;
	};

	dispcc0: clock-controller@af00000 {
		compatible = "qcom,sa8775p-dispcc0";
		reg = <0x0 0xaf00000 0x0 0x20000>;
		clocks = <&gcc GCC_DISP_AHB_CLK>,
				<&rpmhcc RPMH_CXO_CLK>,
				<&rpmhcc RPMH_CXO_CLK_A>,
				<&sleep_clk>,
				<0>,
				<0>,
				<0>,
				<0>,
				<0>,
				<0>,
				<0>,
				<0>;
		power-domains = <&rpmhpd SA8775P_MMCX>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;
	};

	dispcc1: clock-controller@22100000 {
		compatible = "qcom,sa8775p-dispcc1";
		reg = <0x0 0x22100000 0x0 0x20000>;
		clocks = <&gcc GCC_DISP_AHB_CLK>,
				<&rpmhcc RPMH_CXO_CLK>,
				<&rpmhcc RPMH_CXO_CLK_A>,
				<&sleep_clk>,
				<0>,
				<0>,
				<0>,
				<0>,
				<0>,
				<0>,
				<0>,
				<0>;
		power-domains = <&rpmhpd SA8775P_MMCX>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;
	};

	videocc: clock-controller@abf0000 {
		compatible = "qcom,sa8775p-videocc";
		reg = <0x0 0xabf0000 0x0 0x10000>;
		clocks = <&gcc GCC_VIDEO_AHB_CLK>,
				<&rpmhcc RPMH_CXO_CLK>,
				<&rpmhcc RPMH_CXO_CLK_A>,
				<&sleep_clk>;
		power-domains = <&rpmhpd SA8775P_MMCX>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;
	};

	dummy_icc: dummy-icc {
		compatible = "qcom,sa8775p-dummy";
		interconnects = <&nspa_noc MASTER_CDSP_PROC 0 &mc_virt SLAVE_EBI1 0>,
				<&mmss_noc MASTER_MDP0 0 &gem_noc SLAVE_LLCC 0>,
				<&mmss_noc MASTER_MDP1 0 &gem_noc SLAVE_LLCC 0>,
				<&mc_virt MASTER_LLCC 0 &mc_virt SLAVE_EBI1 0>,
				<&mmss_noc MASTER_MDP_CORE1_0 0 &gem_noc SLAVE_LLCC 0>,
				<&mmss_noc MASTER_MDP_CORE1_1 0 &gem_noc SLAVE_LLCC 0>,
				<&gem_noc MASTER_APPSS_PROC 0 &config_noc SLAVE_DISPLAY_CFG 0>,
				<&gem_noc MASTER_APPSS_PROC 0 &config_noc SLAVE_DISPLAY1_CFG 0>,
				<&nspb_noc MASTER_CDSP_PROC 0 &mc_virt SLAVE_EBI1 0>,
				<&gpdsp_anoc MASTER_DSP0 0 &config_noc SLAVE_CLK_CTL 0>,
				<&gpdsp_anoc MASTER_DSP1 0 &config_noc SLAVE_CLK_CTL 0>,
				<&gem_noc MASTER_APPSS_PROC 0 &config_noc SLAVE_CAMERA_CFG 0>,
				<&mmss_noc MASTER_CAMNOC_HF 0 &mc_virt SLAVE_EBI1 0>,
				<&mmss_noc MASTER_CAMNOC_SF 0 &mc_virt SLAVE_EBI1 0>,
				<&mmss_noc MASTER_CAMNOC_ICP 0 &mc_virt SLAVE_EBI1 0>;
		power-domains = <&rpmhpd SA8775P_NSP0>,
				<&rpmhpd SA8775P_NSP1>;
	};

	ipcc_computeL1: mailbox@488000 {
		compatible = "qcom,sa8775p-ipcc", "qcom,ipcc";
		reg = <0x0 0x488000 0x0 0x1000>;
		interrupts = <GIC_SPI 231 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-controller;
		#interrupt-cells = <3>;
		#mbox-cells = <2>;
	};

	mem_dump {
		compatible = "qcom,mem-dump";
		memory-region = <&dump_mem>;

		c0_context {
			qcom,dump-size = <0x800>;
			qcom,dump-id = <0x0>;
		};

		c100_context {
			qcom,dump-size = <0x800>;
			qcom,dump-id = <0x1>;
		};

		c200_context {
			qcom,dump-size = <0x800>;
			qcom,dump-id = <0x2>;
