		};

		l2_tlb10300 {
			qcom,dump-size = <0x6100>;
			qcom,dump-id = <0x127>;
		};

		misc_data {
			qcom,dump-size = <0x1000>;
			qcom,dump-id = <0xe8>;
		};

		pmic {
			qcom,dump-size = <0x80000>;
			qcom,dump-id = <0xe4>;
		};

		rpmh {
			qcom,dump-size = <0x2000000>;
			qcom,dump-id = <0xec>;
		};

		rpm_sw {
			qcom,dump-size = <0x28000>;
			qcom,dump-id = <0xea>;
		};

		tmc_etf {
			qcom,dump-size = <0x10000>;
			qcom,dump-id = <0xf0>;
		};

	};

	mini_dump_mode {
		compatible = "qcom,minidump";
		status = "ok";
	};

	qcom-smem {
		compatible = "qcom,smem";
		memory-region = <&smem_mem>;
		hwlocks = <&tcsr_mutex 3>;
		status = "okay";
	};

	scm_user_intf_device {
		compatible = "qcom,scm-user-intf";
		scm_dev = "scm";
		status = "ok";
	};

	dload_mode {
		compatible = "qcom,dload-mode";
		status = "ok";
	};

	kiumd {
		compatible = "qcom,kiumd";
		qcom,dev-name = "kiumd";
		status = "ok";
	};

	kryo_erp: erp {
	compatible = "arm,arm64-kryo-cpu-erp";
	interrupts = <GIC_PPI 0 IRQ_TYPE_LEVEL_LOW>,
			<GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "l1-l2-faultirq",
				"l3-c0-scu-faultirq",
				"l3-c1-scu-faultirq";
	};

	ddr_bwprofiler {
			compatible = "qcom,ddr_bwprofiler";
			clocks = <&aoss_qmp>;
			clock-names = "qdss_clk";
	};

	scmi_mdss0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi16_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss0";
	};

	scmi_mdss1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi17_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_mdss1";
	};

	scmi_gfx {
		compatible = "qcom,uscmi";

		power-domains = <&scmi18_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_gfx";
	};

	scmi_nsp0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 0>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_nsp0";
	};

	scmi_nsp1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 1>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_nsp1";
	};

	scmi_gpdsp0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 2>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_gpdsp0";
	};

	scmi_gpdsp1 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi19_dvfs 3>;
		power-domain-names = "perf";

		qcom,dev-name = "scmi_gpdsp1";
	};

	scmi_video {
		compatible = "qcom,uscmi";

		power-domains = <&scmi20_dvfs 0>, <&scmi20_dvfs 1>;
		power-domain-names = "perf_video_clk", "perf_video_bw";

		resets = <&scmi20_rst 0>;
		reset-names = "reset_video";

		qcom,dev-name = "scmi_video";
	};

	scmi_camera {
		compatible = "qcom,uscmi";

		power-domains = <&scmi21_dvfs 0>;
		power-domain-names = "perf_camera";

		qcom,dev-name = "scmi_camera";
	};

	scmi_eva {
		compatible = "qcom,uscmi";

		power-domains = <&scmi22_dvfs 0>, <&scmi22_dvfs 1>;
		power-domain-names = "perf_eva_clk", "perf_eva_bw";

		qcom,dev-name = "scmi_eva";
	};

	test_scmi {
		compatible = "qcom,uscmi";

		power-domains = <&scmi63_pd 2> , <&scmi63_dvfs 2>;
		power-domain-names = "power", "perf";

		resets = <&scmi63_rst 0>;
		reset-names = "core";

		qcom,dev-name = "test_scmi";
	};

	test_scmi_perf {
		compatible = "qcom,uscmi";

		power-domains = <&scmi63_dvfs 1>;
		power-domain-names = "perf";

		qcom,dev-name = "test_scmi_perf";
	};

	test_scmi_power {
		compatible = "qcom,uscmi";

		power-domains = <&scmi63_pd 1>;

		qcom,dev-name = "test_scmi_power";
	};

	scmi_uart17 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi11_pd 17>, <&scmi11_dvfs 17>;
		power-domain-names = "power", "perf";

		qcom,dev-name = "scmi_uart17";
	};

	scmi_pcie0 {
		compatible = "qcom,uscmi";

		power-domains = <&scmi5_pd 0>;
		power-domain-names = "power";

		qcom,dev-name = "scmi_pcie0";
	};

	scmi_wlan {
		compatible = "qcom,uscmi";

		power-domains = <&scmi24_pd 0>, <&scmi24_pd 1>;
		power-domain-names = "power_regulator", "power_gpio";

		qcom,dev-name = "scmi_wlan";
	};

	qfprom_pte: qfprom@780158 {
		compatible = "qcom,qfprom";
		reg = <0x0 0x00780158 0x0 0x4>;
		#address-cells = <2>;
		#size-cells = <2>;
	};

	qfprom_tcsr: qfprom@1FFF018 {
		compatible = "qcom,qfprom";
		reg = <0x0 0x1FFF018 0x0 0x4>;
		#address-cells = <2>;
		#size-cells = <2>;
	};

	watchdog@17c10000 {
		interrupts = <GIC_SPI 0 IRQ_TYPE_EDGE_RISING>;
	};
};

&{/firmware} {
	qcom_scm {
		qcom,dload-mode = <&tcsr 0x13000>;
	};
};

&{/reserved-memory} {
	#address-cells = <2>;
	#size-cells = <2>;
	ranges;

	dump_mem: mem_dump_region {
		alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
		compatible = "shared-dma-pool";
		reusable;
		size = <0 0x3000000>;
	};

	sail_mailbox_mem: sail_mailbox_region@90d80000 {
		no-map;
		reg = <0x0 0x90d80000 0x0 0x80000>;
	};

	sail_ota_mem: sail_ota_region@0x90e00000 {
		no-map;
		reg = <0x0 0x90e00000 0x0 0x300000>;
	};

	audio_mdf_mem: audio_mdf_region@ae000000 {
		no-map;
		reg = <0x0 0xae000000 0x0 0x1000000>;
	};

        /* global autoconfigured region for contiguous allocations */
        cma: linux,cma {
                compatible = "shared-dma-pool";
                alloc-ranges = <0x0 0x00000000 0x0 0xdfffffff>;
                reusable;
                alignment = <0x0 0x400000>;
                size = <0x0 0x2000000>;
                linux,cma-default;
        };

	tz-start-count {
		reg = <0x0 0x146d87f8 0x0 0x8>;
		no-map;
	};

	tz-end-count {
		reg = <0x0 0x146d87dc 0x0 0x8>;
		no-map;
	};

	mproc_umdpil_mem: mproc_umdpil_region@95700000 {
		no-map;
		reg = <0x0 0x95700000 0x0 0x500000>;
        };

	gptp_timedata_mem: gptp_timedata_region@acfff000 {
		no-map;
		reg = <0x0 0xACFFF000 0x0 0x1000>;
	};
};

#include "sa8775p-vms.dtsi"

