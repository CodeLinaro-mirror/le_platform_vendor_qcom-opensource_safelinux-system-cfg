&{/reserved-memory} {
	auto_vm1_qcvirtio_net_ring: auto_vm1_qcvirtio_net_ring@f001de000 {
		no-map;
		reg = <0xf 0x001de000 0x0 0x8000>;
		gunyah-label = <0x126>;
	};

	auto_vm1_qcvirtio_con_ring: auto_vm1_qcvirtio_con_ring@f001e6000 {
		no-map;
		reg = <0xf 0x001e6000 0x0 0x8000>;
		gunyah-label = <0x127>;
	};

	auto_vm1_qcvirtio_inp_ring: auto_vm1_qcvirtio_inp_ring@f001ee000 {
		no-map;
		reg = <0xf 0x001ee000 0x0 0x4000>;
		gunyah-label = <0x128>;
	};

	auto_vm1_qcvirtio_rng_ring: auto_vm1_qcvirtio_rng_ring@f001f2000 {
		no-map;
		reg = <0xf 0x001f2000 0x0 0x4000>;
		gunyah-label = <0x129>;
	};

	auto_vm1_qcvirtio_vsock_ring: auto_vm1_qcvirtio_vsock_ring@f001f6000 {
