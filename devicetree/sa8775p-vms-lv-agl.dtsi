};

&soc {
	auto_vm1_be40: auto_vm1_be40@128 {
		qcom,vm = <&auto_vm1>;
		qcom,label = <0x128>;
	};

	auto_vm1_be41: auto_vm1_be41@129 {
		qcom,vm = <&auto_vm1>;
		qcom,label = <0x129>;
	};

	auto_vm1_be42: auto_vm1_be42@130 {
		qcom,vm = <&auto_vm1>;
		qcom,label = <0x12A>;
	};

	auto_vm1_be43: auto_vm1_be43@131 {
