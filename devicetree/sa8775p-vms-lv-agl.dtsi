&auto_vm1_resv0_ring {
	reg = <0xf 0x00222000 0x0 0x8000>;
	gunyah-label = <0x135>;
};

&auto_vm1_resv1_ring {
	reg = <0xf 0x0022a000 0x0 0xed6000>;
	gunyah-label = <0x136>;
};

&{/} {
	// qcvirtio-uclk-driver-linux node
	qcvirtio_uclk {
		compatible = "coqos,uclk";
	};
};
