	auto_vm1_qcvirtio_i2c_ring: auto_vm1_qcvirtio_i2c_ring@f00212000 {
		no-map;
		reg = <0xf 0x00212000 0x0 0x4000>;
		gunyah-label = <0x131>;
	};

	auto_vm1_qcvirtio_snd_ring: auto_vm1_qcvirtio_snd_ring@f00216000 {
		no-map;
		reg = <0xf 0x00216000 0x0 0x4000>;
		gunyah-label = <0x132>;
