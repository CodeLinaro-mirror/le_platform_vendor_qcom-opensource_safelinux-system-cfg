	auto_vm1_qcvirtio_spi_ring: auto_vm1_qcvirtio_spi_ring@f00202000 {
		no-map;
		reg = <0xf 0x00202000 0x0 0x4000>;
		gunyah-label = <0x12D>;
	};

	auto_vm1_qcvirtio_can_ring: auto_vm1_qcvirtio_can_ring@f00206000 {
