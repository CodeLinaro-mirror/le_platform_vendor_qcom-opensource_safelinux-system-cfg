&{/firmware} {
	scmi0: scmi@0 {
		compatible = "qcom,scmi-smc";
		arm,smc-id = <0xc6008012>;
		shmem = <&shmem0>;

		interrupts = <GIC_SPI 920 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "a2p";

		status = "disabled";

		#address-cells = <1>;
		#size-cells = <0>;

		scmi0_pd: protocol@11 {
			reg = <0x11>;
			#power-domain-cells = <1>;
			status = "disabled";
		};

		scmi0_dvfs: protocol@13 {
			reg = <0x13>;
			#power-domain-cells = <1>;
			status = "disabled";
		};

		scmi0_sensor: protocol@15 {
			reg = <0x15>;
			#thermal-sensor-cells = <1>;
			status = "disabled";
		};

		scmi0_rst: protocol@16 {
			reg = <0x16>;
			#reset-cells = <1>;
			status = "disabled";
		};
	};

	scmi1: scmi@1 {
