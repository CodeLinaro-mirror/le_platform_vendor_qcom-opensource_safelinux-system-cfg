&soc {
	sram@d0000000 {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "mmio-sram";
		reg = <0 0xd0000000 0 0x40000>;
		ranges;

		shmem0: scmi-sram@d0000000 {
			compatible = "arm,scmi-shmem";
			reg = <0 0xd0000000 0 0x1000>;
		};

		shmem1: scmi-sram@d0001000 {
			compatible = "arm,scmi-shmem";
			reg = <0 0xd0001000 0 0x1000>;
		};

