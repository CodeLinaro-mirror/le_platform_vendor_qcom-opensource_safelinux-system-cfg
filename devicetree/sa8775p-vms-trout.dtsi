&auto_vm {
	shared-buffers = <&auto_vm_vblk0_ring
				&auto_vm_vblk1_ring
				&auto_vm_vblk2_ring
				&auto_vm_vblk3_ring
				&auto_vm_vblk4_ring
				&auto_vm_vblk5_ring
				&auto_vm_vblk6_ring
				&auto_vm_vblk7_ring
				&auto_vm_vblk8_ring
				&auto_vm_vblk9_ring
				&auto_vm_vblk10_ring
				&auto_vm_vblk11_ring
				&auto_vm_vblk12_ring
				&auto_vm_vblk13_ring
				&auto_vm_vblk14_ring
				&auto_vm_vblk15_ring
				&auto_vm_vblk16_ring
				&auto_vm_vblk17_ring
				&auto_vm_vblk18_ring
				&auto_vm_vblk19_ring
				&auto_vm_vblk20_ring
				&auto_vm_vblk21_ring
				&auto_vm_vblk22_ring
				&auto_vm_vblk23_ring
				&auto_vm_vblk24_ring
				&auto_vm_vnet0_ring
				&auto_vm_vnet1_ring
				&auto_vm_vhab0_ring
				&auto_vm_vhab1_ring
				&auto_vm_vhab2_ring
				&auto_vm_vhab3_ring
				&auto_vm_vhab4_ring
				&auto_vm_vhab5_ring
				&auto_vm_vhab6_ring
				&auto_vm_vhab7_ring
				&auto_vm_vhab8_ring
				&auto_vm_input0_ring
				&auto_vm_input1_ring
				&auto_vm_vconsole_ring
				&auto_vm_vscmi_ring
				&auto_vm_vsock_ring
				&auto_vm_glink_ring
				&auto_vm_frpc_ring
				&auto_vm_i2c0_ring
				&auto_vm_ssr_ring
				&auto_vm_eavb_ring
				&auto_vm_vgpu_ring
				&auto_vm_vsnd_ring
				&auto_vm_vinp_ring
				&auto_vm_vnet_ring
				&auto_vm_resv_ring
				&auto_vm_swiotlb
				>;
};

&soc {
	auto_vm_be47: auto_vm_be47@4F {
		qcom,vm = <&auto_vm>;
		qcom,label = <0x4F>;
	};

	auto_vm_be48: auto_vm_be48@51 {
		qcom,vm = <&auto_vm>;
		qcom,label = <0x51>;
	};

	auto_vm_be49: auto_vm_be49@52 {
		qcom,vm = <&auto_vm>;
		qcom,label = <0x52>;
	};

	auto_vm_be50: auto_vm_be50@53 {
		qcom,vm = <&auto_vm>;
		qcom,label = <0x53>;
	};
};

&auto_vm_0 {
	virtio-backends = <&auto_vm_be0
				&auto_vm_be1
				&auto_vm_be2
				&auto_vm_be3
				&auto_vm_be4
				&auto_vm_be5
