};

&{/reserved-memory} {
	auto_vm_vgpu_ring: auto_vm_vgpu_ring@B40242000 {
		no-map;
		reg = <0xB 0x40242000 0x0 0x8000>;
		gunyah-label = <0x4E>;
	};

	auto_vm_vsnd_ring: auto_vm_vsnd_ring@B4024A000 {
		no-map;
		reg = <0xB 0x4024A000 0x0 0x8000>;
		gunyah-label = <0x4F>;
	};

	auto_vm_vinp_ring: auto_vm_vinp_ring@B40252000 {
		no-map;
		reg = <0xB 0x40252000 0x0 0x4000>;
		gunyah-label = <0x51>;
	};

	auto_vm_vnet_ring: auto_vm_vnet_ring@B40256000 {
		no-map;
		reg = <0xb 0x40256000 0x0 0x8000>;
		gunyah-label = <0x52>;
	};
};

&auto_vm_resv_ring {
	no-map;
	reg = <0xB 0x4025E000 0x0 0xDA2000>;
	gunyah-label = <0x53>;
};
