&soc {
	audio_tlmm@0 {
		compatible = "qcom,apps-pinctlr";
		pinctrl-names = "default";
		pinctrl-0 = <&sec_tdm_sck_active &sec_tdm_ws_active &sec_tdm_din_active &sec_tdm_dout_active &tert_tdm_sck_active &tert_tdm_ws_active &tert_tdm_din_active &tert_tdm_dout_active &hs2_i2s_sck_active &hs2_i2s_ws_active &hs2_i2s_data0_active &hs2_i2s_data1_active &audio_internal_mclk1_active>;
	};

	hsi2s_tlmm@0 {
		compatible = "qcom,apps-pinctlr";
		pinctrl-names = "default";
		pinctrl-0 = <&hs0_i2s_sck_active &hs0_i2s_ws_active &hs0_i2s_data0_active &hs0_i2s_data1_active &hs1_i2s_sck_active &hs1_i2s_ws_active &hs1_i2s_data0_active &hs1_i2s_data1_active>;
	};

	umd_firmware_vm@d0040000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0xd0040000 0x0 0x10000>;
		iommus = <&apps_smmu 0x3080 0x0>;
		dma-coherent;
	};

	umd_glink@780000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x00780000 0x0 0x10000>,
			<0x0 0x90900000 0x0 0x200000>,
			<0x0 0x00408000 0x0 0x1000>;

		interrupts-extended = <&ipcc IPCC_CLIENT_LPASS IPCC_MPROC_SIGNAL_GLINK_QMP IRQ_TYPE_EDGE_RISING>,
				<&ipcc IPCC_CLIENT_CDSP IPCC_MPROC_SIGNAL_GLINK_QMP IRQ_TYPE_EDGE_RISING>,
				<&ipcc IPCC_CLIENT_NSP1  IPCC_MPROC_SIGNAL_GLINK_QMP IRQ_TYPE_EDGE_RISING>,
				<&ipcc IPCC_CLIENT_SLPI  IPCC_MPROC_SIGNAL_GLINK_QMP IRQ_TYPE_EDGE_RISING>,
				<&ipcc IPCC_CLIENT_GPDSP0  IPCC_MPROC_SIGNAL_GLINK_QMP IRQ_TYPE_EDGE_RISING>,
				<&ipcc IPCC_CLIENT_GPDSP1  IPCC_MPROC_SIGNAL_GLINK_QMP IRQ_TYPE_EDGE_RISING>;

		iommus = <&apps_smmu 0x5E0 0x0>;
		dma-coherent;
	};

	umd_nsp_drv@26092000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x26092000 0x0 0x1000>,
			<0x0 0x2A092000 0x0 0x1000>,
			<0x0 0x2634B000 0x0 0x1000>,
			<0x0 0x2A34B000 0x0 0x1000>,
			<0x0 0x26350000 0x0 0x1000>,
			<0x0 0x2A350000 0x0 0x1000>;
		interrupts = <GIC_SPI 867 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 454 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 578 IRQ_TYPE_LEVEL_HIGH>,
			<GIC_SPI 798 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&apps_smmu 0x0D20 0x0>;
		dma-coherent;
	};

	umd_pil@408000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x00408000 0x0 0x1000>,
			<0x0 0x90900000 0x0 0x200000>,
			<0x0 0x00780000 0x0 0x10000>,
			<0x0 0x146d8000 0x0 0x1000>,
			<0x0 0x95700000 0x0 0x500000>,
			<0x0 0x95c00000 0x0 0x1e00000>,
			<0x0 0x9b800000 0x0 0x1e00000>,
			<0x0 0x9fc00000 0x0 0x700000>,
			<0x0 0x9d700000 0x0 0x1e00000>,
			<0x0 0x97b00000 0x0 0x1e00000>,
			<0x0 0x99900000 0x0 0x1e00000>,
			<0x0 0x9D600000 0x0 0x800000>;

		interrupts-extended = <&ipcc IPCC_CLIENT_LPASS IPCC_MPROC_SIGNAL_SMP2P IRQ_TYPE_EDGE_RISING>,
				<&ipcc IPCC_CLIENT_CDSP  IPCC_MPROC_SIGNAL_SMP2P IRQ_TYPE_EDGE_RISING>,
				<&ipcc IPCC_CLIENT_NSP1  IPCC_MPROC_SIGNAL_SMP2P IRQ_TYPE_EDGE_RISING>,
				<&ipcc IPCC_CLIENT_SLPI  IPCC_MPROC_SIGNAL_SMP2P IRQ_TYPE_EDGE_RISING>,
				<&ipcc IPCC_CLIENT_GPDSP0  IPCC_MPROC_SIGNAL_SMP2P IRQ_TYPE_EDGE_RISING>,
				<&ipcc IPCC_CLIENT_GPDSP1  IPCC_MPROC_SIGNAL_SMP2P IRQ_TYPE_EDGE_RISING>,
				<&intc GIC_SPI 486 IRQ_TYPE_LEVEL_HIGH>,
				<&intc GIC_SPI 768 IRQ_TYPE_LEVEL_HIGH>,
				<&intc GIC_SPI 624 IRQ_TYPE_LEVEL_HIGH>;

		iommus = <&apps_smmu 0x2A00 0x0>;
		dma-coherent;
	};

	//Add LLCC node for vfio probe.
	umd_llcc@9200000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x009200000 0x0 0x86A000>,
			<0x0 0x1fc8000 0x0 0x1000>,
			<0x0 0x90900000 0x0 0x200000>,
			<0x0 0x00780000 0x0 0x10000>;
		interrupts = <GIC_SPI 580 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&apps_smmu 0x2E00 0x0>;
		dma-coherent;
	};

	subsystem_ramdump_util@90900000 {
		compatible = "qcom,vfio-platform";
		reg = <0x0 0x90900000 0x0 0x200000>,
			<0x0 0x9b800000 0x0 0x1e00000>,
			<0x0 0x9d700000 0x0 0x1e00000>,
