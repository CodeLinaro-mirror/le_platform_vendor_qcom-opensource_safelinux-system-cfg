	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xff08 0x01 0x0e 0xff08 0x01 0x0b 0xff08 0x01 0x0c 0xff08>;
	};

	pci@1c00000 {
		compatible = "qcom,pcie-ecam-rc";
		reg = <0x04 0x00 0x00 0x10000000>;
		device_type = "pci";
		#address-cells = <0x03>;
		#size-cells = <0x02>;
		ranges = <0x1000000 0x00 0x40000000 0x00 0x40000000 0x00 0x100000 0x2000000 0x00 0x40100000 0x00 0x40100000 0x00 0x1ff00000 0x43000000 0x04 0x10100000 0x04 0x10100000 0x00 0x100000>;
		bus-range = <0x00 0xff>;
		dma-coherent;
		linux,pci-domain = <0x00>;
		interrupts = <0x00 0x133 0x04 0x00 0x134 0x04 0x00 0x135 0x04 0x00 0x138 0x04 0x00 0x139 0x04 0x00 0x13a 0x04 0x00 0x176 0x04 0x00 0x177 0x04>;
		iommu-map = <0x00 0x89 0x00 0x01 0x100 0x89 0x01 0x01>;
		power-domains = <0x8a 0x00>;
		status = "okay";
		interrupt-parent = <0x01>;
		power-domain-names = "power";
	};

	pci@1c10000 {
		compatible = "qcom,pcie-ecam-rc";
		reg = <0x06 0x00 0x00 0x10000000>;
		device_type = "pci";
		#address-cells = <0x03>;
		#size-cells = <0x02>;
		ranges = <0x1000000 0x00 0x60000000 0x00 0x60000000 0x00 0x100000 0x2000000 0x00 0x60100000 0x00 0x60100000 0x00 0x1ff00000 0x43000000 0x06 0x10100000 0x06 0x10100000 0x00 0x100000>;
		bus-range = <0x00 0xff>;
		dma-coherent;
		linux,pci-domain = <0x01>;
		interrupts = <0x00 0x207 0x04 0x00 0x8c 0x04 0x00 0x8d 0x04 0x00 0x8e 0x04 0x00 0x8f 0x04 0x00 0x90 0x04 0x00 0x91 0x04 0x00 0x92 0x04>;
		iommu-map = <0x00 0x89 0x80 0x01 0x100 0x89 0x81 0x01>;
		power-domains = <0x8b 0x00>;
		status = "okay";
		power-domain-names = "power";
		interrupt-parent = <0x01>;
	};

	aliases {
		ethernet0 = "/soc@0/ethernet@23040000";
		ethernet1 = "/soc@0/ethernet@23000000";
		i2c11 = "/soc@0/geniqup@ac0000/i2c@a90000";
		i2c18 = "/soc@0/geniqup@8c0000/i2c@890000";
		serial0 = "/soc@0/geniqup@ac0000/serial@a8c000";
		serial1 = "/soc@0/geniqup@9c0000/serial@990000";
		serial2 = "/soc@0/geniqup@8c0000/serial@88c000";
		spi16 = "/soc@0/geniqup@8c0000/spi@888000";
		ufshc1 = "/soc@0/ufs@1d84000";
		scmichannels = "/soc@0/sram@d0000000";
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gpll0-board-clk {
		compatible = "fixed-clock";
		clock-frequency = <0x11e1a300>;
		#clock-cells = <0x00>;
		phandle = <0x76>;
	};

	bi-tcxo-div2-clk {
		compatible = "fixed-factor-clock";
		clocks = <0x8c>;
		clock-mult = <0x01>;
		clock-div = <0x02>;
		#clock-cells = <0x00>;
		phandle = <0x75>;
	};
};
