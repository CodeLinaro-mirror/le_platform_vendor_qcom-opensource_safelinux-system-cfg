/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Qualcomm Technologies, Inc. SA8775P Ride Firmware Managed";
	compatible = "qcom,sa8775p-ride-fw-managed";

	clocks {

		xo-board-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x249f000>;
			phandle = <0x8c>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			phandle = <0x74>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			enable-method = "psci";
			qcom,freq-domain = <0x02 0x00>;
			next-level-cache = <0x03>;
			phandle = <0x0d>;

			l2-cache {
				compatible = "cache";
				next-level-cache = <0x04>;
				phandle = <0x03>;

				l3-cache {
					compatible = "cache";
					phandle = <0x04>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			enable-method = "psci";
			qcom,freq-domain = <0x02 0x00>;
			next-level-cache = <0x05>;
			phandle = <0x0e>;

			l2-cache {
				compatible = "cache";
				next-level-cache = <0x04>;
				phandle = <0x05>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			enable-method = "psci";
			qcom,freq-domain = <0x02 0x00>;
			next-level-cache = <0x06>;
			phandle = <0x0f>;

			l2-cache {
				compatible = "cache";
				next-level-cache = <0x04>;
				phandle = <0x06>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x300>;
			enable-method = "psci";
			qcom,freq-domain = <0x02 0x00>;
			next-level-cache = <0x07>;
			phandle = <0x10>;

			l2-cache {
				compatible = "cache";
				next-level-cache = <0x04>;
				phandle = <0x07>;
			};
		};

		cpu@10000 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x10000>;
			enable-method = "psci";
			qcom,freq-domain = <0x02 0x01>;
			next-level-cache = <0x08>;
			phandle = <0x11>;

			l2-cache {
				compatible = "cache";
				next-level-cache = <0x09>;
				phandle = <0x08>;

				l3-cache {
					compatible = "cache";
					phandle = <0x09>;
				};
			};
		};

		cpu@10100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x10100>;
			enable-method = "psci";
			qcom,freq-domain = <0x02 0x01>;
			next-level-cache = <0x0a>;
			phandle = <0x12>;

			l2-cache {
				compatible = "cache";
				next-level-cache = <0x09>;
				phandle = <0x0a>;
			};
		};

		cpu@10200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x10200>;
			enable-method = "psci";
			qcom,freq-domain = <0x02 0x01>;
			next-level-cache = <0x0b>;
			phandle = <0x13>;

			l2-cache {
				compatible = "cache";
				next-level-cache = <0x09>;
				phandle = <0x0b>;
			};
		};

		cpu@10300 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x10300>;
			enable-method = "psci";
			qcom,freq-domain = <0x02 0x01>;
			next-level-cache = <0x0c>;
			phandle = <0x14>;

			l2-cache {
				compatible = "cache";
				next-level-cache = <0x09>;
				phandle = <0x0c>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0d>;
				};

				core1 {
					cpu = <0x0e>;
				};

				core2 {
					cpu = <0x0f>;
				};

				core3 {
					cpu = <0x10>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x11>;
				};

				core1 {
					cpu = <0x12>;
				};

				core2 {
					cpu = <0x13>;
				};

				core3 {
					cpu = <0x14>;
				};
			};
		};
	};

