#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	# No build system - nothing to configure

override_dh_auto_build:
	# No build system - nothing to compile

override_dh_auto_install:
	# --- vfio-device-probe service ---
	install -D -m 0644 vfio-device-probe/vfio-device-probe.service \
		debian/safelinux-system-cfg/lib/systemd/system/vfio-device-probe.service

	# --- vfio-device-bind.sh ---
	install -D -m 0755 vfio-device-probe/vfio-device-bind.sh \
		debian/safelinux-system-cfg/usr/bin/vfio-device-bind.sh

	# --- gen5: sa8797_dev.conf ---
	install -D -m 0755 vfio-device-probe/sa8797_dev.conf \
		debian/safelinux-system-cfg/usr/lib/vfio-bind.d/sa8797_dev.conf
