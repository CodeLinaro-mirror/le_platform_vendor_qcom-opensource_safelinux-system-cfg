[Unit]
Description=My Shell Script
After=systemd-modules-load

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
TimeoutStartSec=0
Restart=on-failure
ExecStart=/usr/bin/vfio-device-bind.sh

[Install]
WantedBy=multi-user.target
